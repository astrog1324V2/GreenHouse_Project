[Unit]
Description=Greenhouse monitoring web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/greenhouse-project
EnvironmentFile=/opt/greenhouse-project/.env
ExecStart=/opt/greenhouse-project/.venv/bin/python scripts/run_dev_server.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
